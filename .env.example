# Haunt Verifier worker — environment (Sevalla secrets).
# Copy to .env for local dev; in production set these as Sevalla env vars.
# WordPress NEVER sees these provider keys.

# --- Secrets ---
HLV_ANTHROPIC_API_KEY=sk-ant-...
HLV_GOOGLE_CSE_KEY=
HLV_GOOGLE_CSE_CX=
# Shared HMAC secret — must match HLV_WORKER_SECRET in the WP plugin (wp-config.php).
HLV_WORKER_SECRET=change-me-to-a-long-random-string

# --- Storage (Sevalla Postgres) ---
HLV_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/haunt_verifier

# --- Optional tuning (sane defaults exist for all of these) ---
# HLV_DEFAULT_TEXT_MODEL=claude-haiku-4-5
# HLV_DEFAULT_IMAGE_MODEL=claude-opus-4-8
# HLV_DEFAULT_CONCURRENCY=6
# HLV_GOOGLE_DAILY_QUERY_CAP=9000
# HLV_ENABLE_TESSERACT_BOOST=true

# --- Stranded-run recovery (see README "Stranded-run recovery") ---
# How cold a running run's heartbeat goes before the janitor re-readies it.
# Keep well above the 60s heartbeat so a busy worker is never robbed of its run.
# HLV_STALE_RUN_MINUTES=10
# How many times one run may be re-readied before it is parked as an error.
# HLV_MAX_RUN_RECLAIMS=3
